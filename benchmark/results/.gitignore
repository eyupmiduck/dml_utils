# Generated benchmark output. Keep the directory (via .gitkeep) but do not commit
# results by default; force-add a specific report if you want to publish findings.
*
!.gitkeep
!.gitignore

# Published snapshots are committed under published/<name>/ and need no edit to
# this file: force-add is not required, and a new snapshot cannot be silently
# dropped by a missing whitelist entry.
!published/
!published/**
