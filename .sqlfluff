[sqlfluff]
dialect = postgres
templater = raw
max_line_length = 100

# The grant/rollback files list one EXECUTE grant per routine and now exceed
# SQLFluff's default 20 KB parse limit, which would silently stop linting them.
large_file_skip_byte_limit = 0

# PostgreSQL has many non-reserved keywords (e.g. id, name) that are
# routinely used as identifiers; RF04 is noise for this dialect.
# LT02 (layout.indent) is excluded because IntelliJ formats continuation
# lines such as a CREATE DOMAIN CONSTRAINT clause with an indent that the
# SQLFluff parser does not expect.
#
# Both are project-wide relaxations. Prefer an inline `-- noqa: <rule>` for a
# single construct over widening these globals.
exclude_rules = RF04, LT02

# IntelliJ aligns column types and constraints with multiple spaces. Allow
# that instead of forcing a single space (LT01).
[sqlfluff:layout:type:data_type]
spacing_before = any

[sqlfluff:layout:type:column_constraint_segment]
spacing_before = any
