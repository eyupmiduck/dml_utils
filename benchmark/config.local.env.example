# Personal benchmark overrides.
#
# Copy this file to `config.local.env` (which is gitignored) and set only the
# values you want to change. It is sourced after `config.env`, so anything set
# here overrides the defaults. For example:
#
# BENCH_ROWS=100000000
# BENCH_PK_COLUMNS=3
# BENCH_CHUNK_SIZE=1000
