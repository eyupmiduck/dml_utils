# Benchmark configuration.
#
# Sourced by the benchmark scripts (setup.sh, run.sh, report.sh). Every value can
# be overridden in the environment for a one-off run, or edited here to make a
# different sweep the default. Keep this file in step with the results you
# publish: the report records the values it ran with.
#
# The benchmark uses a DEDICATED PostgreSQL container (not the shared dev stack)
# so the server settings that a reproducible run needs -- above all
# max_worker_processes, which must be >= the thread count -- can be set without
# touching the dev database.

# --- Database server --------------------------------------------------------
# The custom image (roles + plpgsql_check + pg_background). Build it with
# scripts/build-postgres-image.sh postgres:17-alpine if it is missing.
BENCH_IMAGE="${BENCH_IMAGE:-dml-utils-postgres:17-alpine}"
BENCH_LIQUIBASE_IMAGE="${BENCH_LIQUIBASE_IMAGE:-liquibase/liquibase:5.0.4}"
BENCH_CONTAINER="${BENCH_CONTAINER:-dml_utils_benchmark_pg}"
BENCH_VOLUME="${BENCH_VOLUME:-dml_utils_benchmark_pgdata}"
BENCH_NETWORK="${BENCH_NETWORK:-dml_utils_benchmark_net}"

# The image's init script connects to the project database (dml_utils), so the
# database name is fixed; the container is what isolates the benchmark.
BENCH_DB="${BENCH_DB:-dml_utils}"
BENCH_DB_USER="${BENCH_DB_USER:-postgres}"
BENCH_OWNER_USER="${BENCH_OWNER_USER:-dml_utils_owner}"
BENCH_OWNER_PASSWORD="${BENCH_OWNER_PASSWORD:-dml_utils_owner}"

# Published on loopback for inspection with your own client; the scripts talk to
# the container through `docker exec`, so the port is not needed for a run.
BENCH_HOST_PORT="${BENCH_HOST_PORT:-55433}"

# Server settings. max_worker_processes must be at least BENCH_THREADS_TO, with
# headroom for autovacuum and other background workers; changing it requires
# recreating the container (setup.sh --refresh).
BENCH_MAX_WORKER_PROCESSES="${BENCH_MAX_WORKER_PROCESSES:-30}"
BENCH_SHARED_BUFFERS="${BENCH_SHARED_BUFFERS:-512MB}"
BENCH_MAX_CONNECTIONS="${BENCH_MAX_CONNECTIONS:-100}"

# --- Dataset ----------------------------------------------------------------
BENCH_SCHEMA="${BENCH_SCHEMA:-benchmark}"
BENCH_SOURCE_TABLE="${BENCH_SOURCE_TABLE:-bench_source}"
BENCH_TARGET_TABLE="${BENCH_TARGET_TABLE:-bench_target}"
# Source rows. The data is deterministic: row N always has the same key tuple
# and payload, so a refresh reproduces the table exactly.
BENCH_ROWS="${BENCH_ROWS:-1000000}"
# The number of primary-key columns of the driving table, all bigint: 1, 2 or 3
# (matching the chunking engine). The source and target tables are created with
# columns k1..kN.
BENCH_PK_COLUMNS="${BENCH_PK_COLUMNS:-1}"

# Derived from BENCH_PK_COLUMNS: the comma-separated column lists the default
# workload uses (the source and target share the same key columns).
BENCH_PK_COLS_CSV=""
BENCH_PK_SELECT=""
_pk_i=0
while [ "$_pk_i" -lt "$BENCH_PK_COLUMNS" ]; do
    _pk_i=$((_pk_i + 1))
    BENCH_PK_COLS_CSV="${BENCH_PK_COLS_CSV:+$BENCH_PK_COLS_CSV, }k$_pk_i"
    BENCH_PK_SELECT="${BENCH_PK_SELECT:+$BENCH_PK_SELECT, }t.k$_pk_i"
done
# Chunk size, in the unit of BENCH_CHUNK_BY: source rows for primary_key, heap
# blocks for blocks.
BENCH_CHUNK_SIZE="${BENCH_CHUNK_SIZE:-1000}"
# The chunking strategy: primary_key (fixed rows in primary-key order, the
# default) or blocks (physical heap block ranges). blocks requires a quiescent,
# read-only source, which the default INSERT-into-target workload satisfies.
BENCH_CHUNK_BY="${BENCH_CHUNK_BY:-primary_key}"

# The SQL template run once per chunk. It must contain <driving_table> and
# <chunking_clause> exactly once; the driving table is aliased `t`. The default
# copies the chunk's rows into a throwaway target, so the source table is never
# modified and each run starts from the same state.
BENCH_SQL="${BENCH_SQL:-INSERT INTO ${BENCH_SCHEMA}.${BENCH_TARGET_TABLE} (${BENCH_PK_COLS_CSV}, payload) SELECT ${BENCH_PK_SELECT}, t.payload FROM <driving_table> WHERE <chunking_clause>}"

# --- Sweep ------------------------------------------------------------------
BENCH_THREADS_FROM="${BENCH_THREADS_FROM:-1}"
BENCH_THREADS_TO="${BENCH_THREADS_TO:-20}"
# Measured runs per thread value; the mean is taken over these.
BENCH_RUNS="${BENCH_RUNS:-10}"
# Unrecorded warm-up runs per thread value, to page in the table and warm the
# caches before measuring.
BENCH_WARMUP_RUNS="${BENCH_WARMUP_RUNS:-1}"
# Truncate the target table before every run so the INSERT does not accumulate.
BENCH_TRUNCATE_TARGET="${BENCH_TRUNCATE_TARGET:-1}"

# --- Output -----------------------------------------------------------------
BENCH_RESULTS_DIR="${BENCH_RESULTS_DIR:-results}"
BENCH_CSV="${BENCH_CSV:-benchmark.csv}"
BENCH_REPORT="${BENCH_REPORT:-report.md}"
