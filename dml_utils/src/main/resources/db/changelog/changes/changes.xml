<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-schema" author="dml_utils" dbms="postgresql">
        <sqlFile path="sql_changes/001-create-schema.sql" relativeToChangelogFile="true"/>
        <rollback>
            <sqlFile path="rollback/001-create-schema-rollback.sql" relativeToChangelogFile="true"/>
        </rollback>
    </changeSet>

    <changeSet id="002-create-lib-schema" author="dml_utils" dbms="postgresql">
        <sqlFile path="sql_changes/002-create-lib-schema.sql" relativeToChangelogFile="true"/>
        <rollback>
            <sqlFile path="rollback/002-create-lib-schema-rollback.sql" relativeToChangelogFile="true"/>
        </rollback>
    </changeSet>

    <!-- Domains must exist before any routine that types its arguments with
         them, so create them before the functions include. -->
    <changeSet id="004-create-domains" author="dml_utils" dbms="postgresql">
        <sqlFile path="sql_changes/004-create-domains.sql" relativeToChangelogFile="true"/>
        <rollback>
            <sqlFile path="rollback/004-create-domains-rollback.sql" relativeToChangelogFile="true"/>
        </rollback>
    </changeSet>

    <changeSet id="005-create-positive-integer-domain" author="dml_utils" dbms="postgresql">
        <sqlFile path="sql_changes/005-create-positive-integer-domain.sql" relativeToChangelogFile="true"/>
        <rollback>
            <sqlFile path="rollback/005-create-positive-integer-domain-rollback.sql" relativeToChangelogFile="true"/>
        </rollback>
    </changeSet>

    <!-- Stored routines: one changeset each, one file per routine. -->
    <include file="functions.xml" relativeToChangelogFile="true"/>

    <!-- The example table and its updated_at trigger. It runs after functions.xml
         because the trigger calls dml_utils.set_updated_at(). Every table must
         carry created_at/updated_at and this trigger. -->
    <changeSet id="003-create-example-table" author="dml_utils" dbms="postgresql">
        <sqlFile path="sql_changes/003-create-example-table.sql" relativeToChangelogFile="true"/>
        <rollback>
            <sqlFile path="rollback/003-create-example-table-rollback.sql" relativeToChangelogFile="true"/>
        </rollback>
    </changeSet>

    <!-- A single, re-runnable changeset for all caller grants. runOnChange
         makes Liquibase re-apply it whenever this SQL changes, so new grants
         reach existing databases. Keep the statements idempotent. -->
    <!-- The migration tables and their updated_at triggers. It runs after
         functions.xml because the triggers call dml_utils.set_updated_at(). -->
    <changeSet id="006-create-migration-tables" author="dml_utils" dbms="postgresql">
        <sqlFile path="sql_changes/006-create-migration-tables.sql" relativeToChangelogFile="true"/>
        <rollback>
            <sqlFile path="rollback/006-create-migration-tables-rollback.sql" relativeToChangelogFile="true"/>
        </rollback>
    </changeSet>

    <changeSet id="999-grant-privileges" author="dml_utils" dbms="postgresql" runOnChange="true">
        <sqlFile path="sql_changes/999-grant-privileges.sql" relativeToChangelogFile="true"/>
        <rollback>
            <sqlFile path="rollback/999-grant-privileges-rollback.sql" relativeToChangelogFile="true"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
