<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.eyupmiduck</groupId>
        <artifactId>dml-utils-parent</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>docker_java_config</artifactId>
    <packaging>jar</packaging>

    <!-- Carries docker-java.properties onto classpaths that need it
         (jOOQ codegen plugin realm, test classpath). It is a build shim, not a
         consumable artifact, so it is installed but never deployed. -->
    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>
</project>
