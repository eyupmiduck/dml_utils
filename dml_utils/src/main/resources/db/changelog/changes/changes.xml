<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-schema" author="dml_utils" dbms="postgresql">
        <sqlFile path="sql_changes/001-create-schema.sql" relativeToChangelogFile="true"/>
        <rollback>
            <sqlFile path="rollback/001-create-schema-rollback.sql" relativeToChangelogFile="true"/>
        </rollback>
    </changeSet>

    <changeSet id="002-create-lib-schema" author="dml_utils" dbms="postgresql">
        <sqlFile path="sql_changes/002-create-lib-schema.sql" relativeToChangelogFile="true"/>
        <rollback>
            <sqlFile path="rollback/002-create-lib-schema-rollback.sql" relativeToChangelogFile="true"/>
        </rollback>
    </changeSet>

    <changeSet id="003-create-data-schema" author="dml_utils" dbms="postgresql">
        <sqlFile path="sql_changes/003-create-data-schema.sql" relativeToChangelogFile="true"/>
        <rollback>
            <sqlFile path="rollback/003-create-data-schema-rollback.sql" relativeToChangelogFile="true"/>
        </rollback>
    </changeSet>

    <!-- Domains must exist before any routine that types its arguments with
         them, so create them before the functions include. -->
    <changeSet id="004-create-domains" author="dml_utils" dbms="postgresql">
        <sqlFile path="sql_changes/004-create-domains.sql" relativeToChangelogFile="true"/>
        <rollback>
            <sqlFile path="rollback/004-create-domains-rollback.sql" relativeToChangelogFile="true"/>
        </rollback>
    </changeSet>

    <!-- The boundary-key check helper. It needs only the migration_key type
         (created above), so it is defined before the table whose CHECK calls
         it. -->
    <changeSet id="005-create-migration-key-check" author="dml_utils" dbms="postgresql"
               runOnChange="true">
        <sqlFile path="sql_changes/005-create-migration-key-check.sql"
                 relativeToChangelogFile="true" splitStatements="false"/>
        <rollback>
            <sqlFile path="rollback/005-create-migration-key-check-rollback.sql"
                     relativeToChangelogFile="true"/>
        </rollback>
    </changeSet>

    <!-- The migration tables. No triggers yet: the tables do not depend on any
         routine, and the routines below reference them, so the tables come
         first. -->
    <changeSet id="006-create-migration-tables" author="dml_utils" dbms="postgresql">
        <sqlFile path="sql_changes/006-create-migration-tables.sql" relativeToChangelogFile="true"/>
        <rollback>
            <sqlFile path="rollback/006-create-migration-tables-rollback.sql" relativeToChangelogFile="true"/>
        </rollback>
    </changeSet>

    <!-- Stored routines: one changeset each, one file per routine. They run
         after the tables so routines may reference them. -->
    <include file="functions.xml" relativeToChangelogFile="true"/>

    <!-- The tables' triggers, one per file. They call the routines defined
         above, so they run after the functions include. -->
    <include file="triggers.xml" relativeToChangelogFile="true"/>

    <!-- A single, re-runnable changeset for all caller grants. runOnChange
         makes Liquibase re-apply it whenever this SQL changes, so new grants
         reach existing databases. Keep the statements idempotent. -->
    <changeSet id="999-grant-privileges" author="dml_utils" dbms="postgresql" runOnChange="true">
        <sqlFile path="sql_changes/999-grant-privileges.sql" relativeToChangelogFile="true"/>
        <rollback>
            <sqlFile path="rollback/999-grant-privileges-rollback.sql" relativeToChangelogFile="true"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
